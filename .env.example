# Belief Engine Configuration
# Copy this to .env and fill in your values

# Required: Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Telegram notifications
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: Model overrides (defaults to claude-sonnet-4-20250514)
# BELIEF_MODEL_DEFAULT=claude-sonnet-4-20250514
# BELIEF_MODEL_FAST=claude-haiku-3-20240307
# BELIEF_MODEL_STRONG=claude-sonnet-4-20250514
