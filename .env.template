# Belief Engine v2.0 — Environment Configuration
# Copy to .env and fill in your values

# ── Anthropic API ──────────────────────────────────────────
ANTHROPIC_API_KEY=your_key_here

# ── Model routing ─────────────────────────────────────────
# Default models per role. Override any to change routing.
BELIEF_MODEL_INTAKE=claude-haiku-4-5-20251001
BELIEF_MODEL_RESEARCH=claude-sonnet-4-6
BELIEF_MODEL_PLANNER=claude-sonnet-4-6
BELIEF_MODEL_ARCHITECT=claude-sonnet-4-6
BELIEF_MODEL_BUILDER=claude-sonnet-4-6
BELIEF_MODEL_TESTER=claude-sonnet-4-6
BELIEF_MODEL_DEBUGGER=claude-sonnet-4-6
BELIEF_MODEL_GAP_ANALYST=claude-sonnet-4-6
BELIEF_MODEL_SYNTHESIZER=claude-sonnet-4-6
BELIEF_MODEL_VALIDATOR=claude-sonnet-4-6
BELIEF_MODEL_LATIOS=claude-sonnet-4-6

# ── Budget controls ────────────────────────────────────────
BELIEF_MAX_COST_PER_BUILD=10.00
BELIEF_MAX_ITERATIONS=3
BELIEF_MAX_STEPS_PER_TASK=25

# ── Search ────────────────────────────────────────────────
BRAVE_API_KEY=your_key_here
GITHUB_TOKEN=your_token_here

# ── Local models (optional — reduces cost) ────────────────
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# ── Telegram notifications ────────────────────────────────
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id

# ── Storage ───────────────────────────────────────────────
BELIEF_DB_PATH=~/.belief-engine/builds.db
BELIEF_CHROMA_PATH=~/.belief-engine/chroma
BELIEF_OUTPUT_DIR=./output
BELIEF_CACHE_DIR=./cache

# ── Logging ───────────────────────────────────────────────
BELIEF_LOG_LEVEL=INFO
BELIEF_LOG_JSON=false
